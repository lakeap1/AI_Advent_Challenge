[Unit]
Description=AI Advent Day 30 private Ollama runtime

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_QUEUE=3
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MODELS=%h/ai-advent-day30/.models
Environment=HOME=%h/ai-advent-day30/data/ollama-home
ExecStart=%h/ai-advent-day30/.runtime/v0.40.3/bin/ollama serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/ai-advent-day30/.models %h/ai-advent-day30/data/ollama-home

[Install]
WantedBy=default.target
