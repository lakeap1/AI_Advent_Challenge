[Unit]
Description=Graphics learning Qwen3 embedding runtime (private CPU)
After=network-online.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11436
Environment=OLLAMA_MODELS=%h/ai-advent-day31/.models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=GOMAXPROCS=2
ExecStart=%h/ai-advent-day30/.runtime/v0.40.3/bin/ollama serve
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
